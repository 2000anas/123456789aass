{
  "name": "elyptek",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Elyptek financial cash flow and employee attendance management",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build && npm start",
    "dev:netlify": "npx netlify dev",
    "dev:local": "concurrently -n api,web -c blue,green \"tsx watch src/server.ts\" \"vite\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:web": "vite",
    "build": "npx tsc -p tsconfig.server.json && npx vite build",
    "start": "NODE_ENV=production node dist/server.js",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.3",
    "axios": "^1.8.3",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.483.0",
    "mongoose": "^8.12.1",
    "morgan": "^1.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^7.4.0",
    "recharts": "^2.15.1",
    "serverless-http": "^3.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@netlify/functions": "^3.1.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  }
}
